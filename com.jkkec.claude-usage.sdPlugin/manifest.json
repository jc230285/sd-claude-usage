{
  "Name": "JarvisAI Usage",
  "Version": "2.0.0",
  "Author": "jkkec",
  "Description": "Shows JarvisAI provider health, burn rate, activity and Claude fallback usage",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "Category": "JarvisAI",
  "CategoryIcon": "imgs/plugin",
  "UUID": "com.jkkec.claude-usage",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "JarvisAI Usage",
      "UUID": "com.jkkec.claude-usage.usage",
      "Icon": "imgs/actions/usage/icon",
      "PropertyInspectorPath": "ui/property-inspector.html",
      "Tooltip": "Shows JarvisAI provider fleet health and usage",
      "States": [
        {
          "Image": "imgs/actions/usage/icon",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Calendar Agenda",
      "UUID": "com.jkkec.claude-usage.calendar",
      "Icon": "imgs/actions/usage/icon",
      "PropertyInspectorPath": "ui/calendar-inspector.html",
      "Tooltip": "Next meetings from Scale42 Home",
      "States": [
        {
          "Image": "imgs/actions/usage/icon",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Heather ETA",
      "UUID": "com.jkkec.claude-usage.heather",
      "Icon": "imgs/actions/usage/icon",
      "Tooltip": "Heather location and minutes to home",
      "States": [
        {
          "Image": "imgs/actions/usage/icon",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "NAS Storage",
      "UUID": "com.jkkec.claude-usage.nas",
      "Icon": "imgs/actions/usage/icon",
      "Tooltip": "NAS capacity and storage mix",
      "States": [
        {
          "Image": "imgs/actions/usage/icon",
          "TitleAlignment": "middle"
        }
      ],
      "PropertyInspectorPath": "ui/home-inspector.html"
    },
    {
      "Name": "Health-Aware App",
      "UUID": "com.jkkec.claude-usage.healthapp",
      "Icon": "imgs/actions/usage/icon",
      "Tooltip": "Recent app and service health",
      "States": [
        {
          "Image": "imgs/actions/usage/icon",
          "TitleAlignment": "middle"
        }
      ],
      "PropertyInspectorPath": "ui/home-inspector.html"
    }
  ]
}
